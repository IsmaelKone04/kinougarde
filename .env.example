# Copier ce fichier en `.env` puis renseigner les valeurs.
# `.env` est ignoré par git : aucun identifiant ne doit être commité.

DB_HOST=localhost
DB_NAME=kinougarde
DB_USER=root
DB_PASS=

# "true" en développement uniquement : affiche les erreurs SQL à l'écran.
# En production, les erreurs sont journalisées mais jamais montrées au visiteur.
APP_DEBUG=true
